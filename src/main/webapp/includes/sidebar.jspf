<%!

    private String sidebarEscape(Object value) {

        if (value == null) {
            return "";
        }

        return String.valueOf(value)
            .replace("&", "&amp;")
            .replace("\"", "&quot;")
            .replace("'", "&#39;")
            .replace("<", "&lt;")
            .replace(">", "&gt;");
    }


    private String sidebarDepartmentName(
            String department) {

        if (
            department == null
            ||
            department.isBlank()
        ) {
            return "";
        }

        switch (
            department.trim().toUpperCase()
        ) {

            case "PENTADBIRAN_KORPORAT":
                return "Pentadbiran dan Korporat";

            case "KEWANGAN":
                return "Kewangan";

            case "PEMBANGUNAN_PERNIAGAAN_OPERASI":
                return "Pembangunan Perniagaan dan Operasi";

            default:
                return department;
        }
    }

%>


<%

    // =========================================================
    // USER
    // =========================================================

    String sidebarRole =
        session.getAttribute("userRole") == null
            ? "STAFF"
            : session
                .getAttribute("userRole")
                .toString()
                .trim()
                .toUpperCase();


    String sidebarName =
        session.getAttribute("userName") == null
            ? "Pengguna"
            : session
                .getAttribute("userName")
                .toString();


    String sidebarDepartment =
        session.getAttribute("userDepartment") == null
            ? ""
            : session
                .getAttribute("userDepartment")
                .toString();


    if (
        sidebarName == null
        ||
        sidebarName.isBlank()
    ) {

        sidebarName = "Pengguna";
    }


    String sidebarInitial =
        sidebarName
            .substring(0, 1)
            .toUpperCase();


    String sidebarDepartmentDisplay =
        sidebarDepartmentName(
            sidebarDepartment
        );


    boolean sidebarIsHR =
        "HR".equals(sidebarRole);

    boolean sidebarIsHOD =
        "HOD".equals(sidebarRole);

    boolean sidebarIsManagement =
        "MANAGEMENT".equals(sidebarRole);


    // =========================================================
    // CURRENT PAGE
    // =========================================================

    String sidebarCurrentPath =
        request.getServletPath();


    if (sidebarCurrentPath == null) {
        sidebarCurrentPath = "";
    }


    boolean dashboardActive =
        "/dashboard".equals(
            sidebarCurrentPath
        );


    boolean applyActive =
        "/apply".equals(
            sidebarCurrentPath
        );


    boolean applicationsActive =
        "/applications".equals(
            sidebarCurrentPath
        )
        ||
        "/edit-leave".equals(
            sidebarCurrentPath
        )
        ||
        "/print-leave".equals(
            sidebarCurrentPath
        );


    boolean calendarActive =
        "/calendar".equals(
            sidebarCurrentPath
        );


    boolean balanceActive =
        "/my-leave-balance".equals(
            sidebarCurrentPath
        );


    boolean medicalDentalActive =
        "/medical-dental".equals(
            sidebarCurrentPath
        );
    
    boolean medicalDentalManagementActive =
    	    "/medical-dental-management".equals(
    	        sidebarCurrentPath
    	    );


    boolean inventoryActive =
        "/inventory".equals(
            sidebarCurrentPath
        )
        ||
        "/inventory-request".equals(
            sidebarCurrentPath
        );


    boolean inventoryRequestsActive =
        "/inventory-requests".equals(
            sidebarCurrentPath
        );


    boolean adminActive =
        "/admin".equals(
            sidebarCurrentPath
        );


    boolean hodStaffActive =
        "/hod-staff".equals(
            sidebarCurrentPath
        );


    boolean staffActive =
        "/staff".equals(
            sidebarCurrentPath
        )
        ||
        "/leave-balance".equals(
            sidebarCurrentPath
        );


    boolean holidayActive =
        "/public-holidays".equals(
            sidebarCurrentPath
        );


    boolean inventoryAdminActive =
        "/inventory-admin".equals(
            sidebarCurrentPath
        );


    boolean inventoryRequestAdminActive =
        "/inventory-request-admin".equals(
            sidebarCurrentPath
        );


    boolean inventoryReturnAdminActive =
        "/inventory-return-admin".equals(
            sidebarCurrentPath
        );


    boolean inventoryTransactionsActive =
        "/inventory-transactions".equals(
            sidebarCurrentPath
        );


    // =========================================================
    // VEHICLE MODULE
    // =========================================================

    boolean vehicleApplyActive =
        "/vehicle-apply".equals(
            sidebarCurrentPath
        );

    boolean myVehicleApplicationsActive =
        "/my-vehicle-applications".equals(
            sidebarCurrentPath
        );

    boolean vehicleCalendarActive =
        "/vehicle-calendar".equals(
            sidebarCurrentPath
        );

    boolean vehicleApprovalActive =
        "/vehicle-approval".equals(
            sidebarCurrentPath
        );

    boolean vehicleManagementActive =
        "/vehicle-management".equals(
            sidebarCurrentPath
        );


    // =========================================================
    // AUDIT TRAIL
    // =========================================================

    boolean activityLogActive =
        "/activity-log".equals(
            sidebarCurrentPath
        );


    // =========================================================
    // ATTENDANCE MODULE
    // =========================================================

    boolean attendanceActive =
        "/attendance".equals(
            sidebarCurrentPath
        );


    boolean attendanceRecordsActive =
        "/attendance-records".equals(
            sidebarCurrentPath
        );

%>


