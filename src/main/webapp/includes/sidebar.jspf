                                width="16"
                                height="18"
                                rx="2"
                            ></rect>

                            <path d="M8 8h8"></path>
                            <path d="M8 12h8"></path>
                            <path d="M8 16h5"></path>

                        </svg>

                    </span>

                    <span>
                        Log Aktiviti
                    </span>

                </a>


            </nav>


        <% } %>


    </div>


    <!-- =====================================================
         PROFILE
         ===================================================== -->

    <div class="sidebar-bottom">


        <div class="profile">


            <div class="avatar">

                <%= sidebarEscape(
                    sidebarInitial
                ) %>

            </div>


            <div class="sidebar-profile-info">


                <b>

                    <%= sidebarEscape(
                        sidebarName
                    ) %>

                </b>


                <small>

                    <% if (sidebarIsHR) { %>

                        Pentadbir Sistem

                    <% } else if (sidebarIsManagement) { %>

                        Pengurusan

                    <% } else if (sidebarIsHOD) { %>

                        Ketua Unit

                    <% } else { %>

                        Staf

                    <% } %>

                </small>


                <%

                    if (
                        !sidebarIsHR
                        &&
                        sidebarDepartmentDisplay != null
                        &&
                        !sidebarDepartmentDisplay.isBlank()
                    ) {

                %>


                    <small>

                        <%= sidebarEscape(
                            sidebarDepartmentDisplay
                        ) %>

                    </small>


                <% } %>


            </div>


        </div>


        <!-- LOGOUT -->

        <a
            class="logout"
            href="<%= request.getContextPath() %>/logout"
        >


            <span class="logout-icon">

                <svg viewBox="0 0 24 24">

                    <path d="M9 5H5v14h4"></path>
                    <path d="M13 8l4 4-4 4"></path>
                    <path d="M17 12H9"></path>

                </svg>

            </span>


            <span>
                Log Keluar
            </span>


        </a>


    </div>


</aside>


<!-- =========================================================
     UNIVERSAL SIDEBAR + LEGACY HEADER FIX
     ========================================================= -->

<style>

    /* ========================================================
       SIDEBAR SVG PROTECTION
       ======================================================== */

    html body .sidebar .nav-icon {

        width: 20px !important;
        height: 20px !important;

        min-width: 20px !important;
        min-height: 20px !important;

        flex: 0 0 20px !important;

        display: inline-flex !important;

        align-items: center !important;
        justify-content: center !important;

        visibility: visible !important;
        opacity: 1 !important;

        overflow: visible !important;

        color: #8492a8 !important;

        font-size: 0 !important;
    }


    html body .sidebar .nav-icon svg {

        width: 18px !important;
        height: 18px !important;

        min-width: 18px !important;
        min-height: 18px !important;

        display: block !important;

        visibility: visible !important;
        opacity: 1 !important;

        overflow: visible !important;

        fill: none !important;

        stroke: currentColor !important;

        stroke-width: 1.8 !important;

        stroke-linecap: round !important;
        stroke-linejoin: round !important;
    }


    html body .sidebar .nav-icon svg path,
    html body .sidebar .nav-icon svg rect,
    html body .sidebar .nav-icon svg circle,
    html body .sidebar .nav-icon svg line,
    html body .sidebar .nav-icon svg polyline {

        visibility: visible !important;

        opacity: 1 !important;

        fill: none !important;

        stroke: currentColor !important;
    }


    html body .sidebar nav a {

        display: flex !important;

        align-items: center !important;

        gap: 11px !important;
    }


    html body .sidebar nav a:hover .nav-icon,
    html body .sidebar nav a.active .nav-icon {

        color: #8d1f2d !important;
    }


    /* ========================================================
       LOGOUT ICON
       ======================================================== */

    html body .sidebar .logout-icon {

        width: 16px !important;
        height: 16px !important;

        display: inline-flex !important;

        align-items: center !important;
        justify-content: center !important;
    }


    html body .sidebar .logout-icon svg {

        width: 15px !important;
        height: 15px !important;

        display: block !important;

        fill: none !important;

        stroke: currentColor !important;

        stroke-width: 1.8 !important;

        stroke-linecap: round !important;
        stroke-linejoin: round !important;
    }


    /* ========================================================
       MOBILE CLOSE BUTTON
       ======================================================== */

    html body .sidebar .sidebar-mobile-close {

        display: none !important;

        visibility: hidden !important;

        opacity: 0 !important;
    }


    @media (max-width: 900px) {

        html body .sidebar .sidebar-mobile-close {

            display: inline-flex !important;

            visibility: visible !important;

            opacity: 1 !important;
        }
    }


    /* ========================================================
       LEGACY PAGE USER CHIP
       ======================================================== */

    html body main .user-chip {

        min-height: 42px !important;

        display: flex !important;

        flex-direction: row !important;

        align-items: center !important;

        justify-content: flex-start !important;

        gap: 8px !important;

        flex: 0 0 auto !important;

        padding:
            5px
            11px
            5px
            5px !important;

        margin: 0 !important;

        border:
            1px solid #e6e9ef !important;

        border-radius:
            12px !important;

        background:
            #ffffff !important;

        box-shadow:
            0 4px 14px
            rgba(
                20,
                28,
                45,
                0.05
            ) !important;

        color:
            #172033 !important;

        white-space:
            nowrap !important;

        visibility:
            visible !important;

        opacity:
            1 !important;
    }


    html body main .user-chip .avatar {

        width: 32px !important;
        height: 32px !important;

        min-width: 32px !important;
        min-height: 32px !important;

        display: grid !important;

        place-items: center !important;

        margin: 0 !important;

        padding: 0 !important;

        border:
            1px solid #efdade !important;

        border-radius:
            9px !important;

        background:
            linear-gradient(
                135deg,
                #fff0f2,
                #fff7e6
            ) !important;

        color:
            #8d1f2d !important;

        font-size:
            12px !important;

        font-weight:
            800 !important;

        line-height:
            1 !important;
    }


    html body main .user-chip b {

        display: inline-block !important;

        margin: 0 !important;

        padding: 0 !important;

        color:
            #303a4c !important;

        font-size:
            12px !important;

        font-weight:
            700 !important;

        line-height:
            1.25 !important;

        white-space:
            nowrap !important;
    }


    /* ========================================================
       INJECTED HEADER ACTION WRAPPER
       ======================================================== */

    html body main .pkb-auto-header-actions {

        display: flex !important;

        align-items: center !important;

        justify-content: flex-end !important;

        gap: 10px !important;

        flex: 0 0 auto !important;

        margin-left: auto !important;
    }


    /* ========================================================
       AUTO NOTIFICATION BELL
       ======================================================== */

    html body main .pkb-auto-notification {

        position: relative !important;

        width: 42px !important;
        height: 42px !important;

        min-width: 42px !important;
        min-height: 42px !important;

        display: inline-flex !important;

        align-items: center !important;
        justify-content: center !important;

        padding: 0 !important;
        margin: 0 !important;

        border:
            1px solid #e6e9ef !important;

        border-radius:
            12px !important;

        background:
            #ffffff !important;

        color:
            #697386 !important;

        box-shadow:
            0 4px 14px
            rgba(
                20,
                28,
                45,
                0.05
            ) !important;

        text-decoration:
            none !important;
    }


    html body main .pkb-auto-notification:hover {

        background:
            #fff7f8 !important;

        border-color:
            #e8cdd1 !important;

        color:
            #8d1f2d !important;
    }


    html body main .pkb-auto-notification svg {

        width: 19px !important;
        height: 19px !important;

        display: block !important;

        fill: none !important;

        stroke:
            currentColor !important;

        stroke-width:
            1.8 !important;

        stroke-linecap:
            round !important;

        stroke-linejoin:
            round !important;
    }


    html body main .pkb-auto-notification-count {

        position: absolute !important;

        top: -6px !important;
        right: -6px !important;

        min-width: 19px !important;
        height: 19px !important;

        display: none;

        align-items: center !important;
        justify-content: center !important;

        padding:
            0
            5px !important;

        border:
            2px solid #ffffff !important;

        border-radius:
            999px !important;

        background:
            #8d1f2d !important;

        color:
            #ffffff !important;

        font-size:
            9px !important;

        font-weight:
            800 !important;

        line-height:
            1 !important;
    }


    /* ========================================================
       FORCE COMMON PAGE HEADERS INTO ONE ROW
       ======================================================== */

    html body main .calendar-page-header,
    html body main .admin-page-header,
    html body main .staff-page-header,
    html body main .holiday-page-header,
    html body main .inventory-admin-header,
    html body main .inventory-request-admin-header,
    html body main .inventory-header,
    html body main .topbar {

        display: flex !important;

        flex-direction: row !important;

        align-items: flex-start !important;

        justify-content: space-between !important;

        gap: 20px !important;

        width: 100% !important;
    }


    /* ========================================================
       MOBILE HEADER
       ======================================================== */

    @media (max-width: 650px) {

        html body main .calendar-page-header,
        html body main .admin-page-header,
        html body main .staff-page-header,
        html body main .holiday-page-header,
        html body main .inventory-admin-header,
        html body main .inventory-request-admin-header,
        html body main .inventory-header,
        html body main .topbar {

            flex-direction:
                column !important;

            align-items:
                stretch !important;
        }


        html body main .pkb-auto-header-actions {

            width: 100% !important;

            justify-content:
                flex-start !important;

            margin-left:
                0 !important;
        }
    }

</style>


<!-- =========================================================
     GLOBAL SCRIPT
     ========================================================= -->

<script>

(function () {


    // =========================================================
    // SIDEBAR
    // =========================================================

    const button =
        document.getElementById(
            "mobileMenuButton"
        );


    const closeButton =
        document.getElementById(
            "sidebarCloseButton"
        );


    const overlay =
        document.getElementById(
            "sidebarOverlay"
        );


    const sidebar =
        document.getElementById(
            "pkbSidebar"
        );


    const menuArea =
        sidebar
            ? sidebar.querySelector(
                ".sidebar-menu-area"
              )
            : null;


    function openSidebar() {

        document.body.classList.add(
            "sidebar-mobile-open"
        );


        if (button) {

            button.setAttribute(
                "aria-expanded",
                "true"
            );
        }
    }


    function closeSidebar() {

        document.body.classList.remove(
            "sidebar-mobile-open"
        );


        if (button) {

            button.setAttribute(
                "aria-expanded",
                "false"
            );
        }
    }


    if (button) {

        button.addEventListener(
            "click",
            openSidebar
        );
    }


    if (closeButton) {

        closeButton.addEventListener(
            "click",
            closeSidebar
        );
    }


    if (overlay) {

        overlay.addEventListener(
            "click",
            closeSidebar
        );
    }


    if (sidebar) {

        sidebar
            .querySelectorAll(
                "nav a"
            )
            .forEach(
                function (link) {

                    link.addEventListener(
                        "click",
                        function () {

                            if (
                                window.innerWidth
                                <=
                                900
                            ) {

                                closeSidebar();
                            }
                        }
                    );
                }
            );
    }


    window.addEventListener(
        "resize",
        function () {

            if (
                window.innerWidth
                >
                900
            ) {

                closeSidebar();
            }
        }
    );


    document.addEventListener(
        "keydown",
        function (event) {

            if (
                event.key ===
                "Escape"
            ) {

                closeSidebar();
            }
        }
    );


    if (menuArea) {

        menuArea.scrollTop = 0;
    }


    // =========================================================
    // LEGACY HEADER FIX
    // =========================================================

    function setupLegacyHeader() {


        const main =
            document.querySelector(
                "main"
            );


        if (!main) {
            return;
        }


        /*
         * New pages using header-actions.jspf already have
         * .pkb-header-actions.
         *
         * Do not alter those.
         */

        if (
            main.querySelector(
                ".pkb-header-actions"
            )
        ) {

            return;
        }


        const chip =
            main.querySelector(
                ".user-chip"
            );


        if (!chip) {
            return;
        }


        /*
         * Avoid duplicate conversion.
         */

        if (
            chip.closest(
                ".pkb-auto-header-actions"
            )
        ) {

            return;
        }


        /*
         * Find the old page header containing user-chip.
         */

        const oldHeader =
            chip.parentElement;


        if (!oldHeader) {
            return;
        }


        /*
         * Create header actions wrapper.
         */

        const actions =
            document.createElement(
                "div"
            );


        actions.className =
            "pkb-auto-header-actions";


        /*
         * Notification Bell.
         */

        const bell =
            document.createElement(
                "a"
            );


        bell.className =
            "pkb-auto-notification";


        bell.href =
            "<%= request.getContextPath() %>/notifications";


        bell.title =
            "Notifikasi";


        bell.setAttribute(
            "aria-label",
            "Notifikasi"
        );


        bell.innerHTML =
            '<svg viewBox="0 0 24 24" aria-hidden="true">'
            +
            '<path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"></path>'
            +
            '<path d="M10 21h4"></path>'
            +
            '</svg>'
            +
            '<span class="pkb-auto-notification-count">0</span>';


        /*
         * Put bell + original user chip inside wrapper.
         */

        actions.appendChild(
            bell
        );


        actions.appendChild(
            chip
        );


        oldHeader.appendChild(
            actions
        );


        // =====================================================
        // NOTIFICATION COUNT
        // =====================================================

        const badge =
            bell.querySelector(
                ".pkb-auto-notification-count"
            );


        function loadNotificationCount() {


            fetch(
                "<%= request.getContextPath() %>/notification-count",
                {
                    method:
                        "GET",

                    credentials:
                        "same-origin",

                    headers: {
                        "X-Requested-With":
                            "XMLHttpRequest"
                    }
                }
            )
            .then(
                function (response) {

                    if (!response.ok) {

                        throw new Error(
                            "Notification count error"
                        );
                    }


                    return response.text();
                }
            )
            .then(
                function (text) {


                    let count = 0;


                    try {


                        const data =
                            JSON.parse(
                                text
                            );


                        if (
                            data
                            &&
                            typeof data.count
                            !==
                            "undefined"
                        ) {

                            count =
                                parseInt(
                                    data.count,
                                    10
                                )
                                ||
                                0;
                        }


                    } catch (error) {


                        count =
                            parseInt(
                                text,
                                10
                            )
                            ||
                            0;
                    }


                    if (count > 0) {


                        badge.textContent =
                            count > 99
                                ? "99+"
                                : String(
                                    count
                                  );


                        badge.style.display =
                            "flex";


                    } else {


                        badge.style.display =
                            "none";
                    }
                }
            )
            .catch(
                function () {

                    badge.style.display =
                        "none";
                }
            );
        }


        loadNotificationCount();


        window.setInterval(
            loadNotificationCount,
            30000
        );
    }


    /*
     * sidebar.jspf is normally rendered before the page
     * content below it, therefore wait until the whole DOM
     * has finished loading before finding user-chip.
     */

    if (
        document.readyState
        ===
        "loading"
    ) {


        document.addEventListener(
            "DOMContentLoaded",
            setupLegacyHeader
        );


    } else {


        setupLegacyHeader();
    }


})();

</script>